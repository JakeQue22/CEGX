# =============================================================================
# CEGX Procurement CRM Backend - Environment Variables
# =============================================================================
# Production defaults. Override values via Docker Compose env or host env vars.

# Application
NODE_ENV=development
PORT=3003
APP_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002

# Database (PostgreSQL - port 5433 to avoid conflict with existing postgres on 5432)
DATABASE_URL=postgresql://cegx:cegxpass@localhost:5433/cegx?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# Admin Account (seeded on first run)
ADMIN_EMAIL=admin@cegx.co.uk
ADMIN_PASSWORD=Admin@123456

# JWT Authentication
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=365d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=365d

# SMTP (Nodemailer) - fallback if not configured in DB settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Grok AI (xAI) - Get your API key from https://console.x.ai
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-3
