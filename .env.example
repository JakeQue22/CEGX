# Root environment file for Docker Compose
# Copy this to .env and fill in your values

# PostgreSQL (port 5433 to avoid conflict with existing postgres on 5432)
POSTGRES_USER=cegx
POSTGRES_PASSWORD=cegxpass
POSTGRES_DB=cegx

# Admin Account (seeded on first run)
ADMIN_EMAIL=admin@cegx.co.uk
ADMIN_PASSWORD=Admin@123456

# JWT Secrets (minimum 32 characters each)
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-minimum-32-characters-here
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-here
JWT_EXPIRES_IN=365d
JWT_REFRESH_EXPIRES_IN=365d

# URLs – Production example (with nginx reverse proxy):
#   FRONTEND_URL=https://cegx.quantumonline.co.uk
#   APP_URL=https://cegx.quantumonline.co.uk
#   NEXT_PUBLIC_API_URL=/api
#   CORS_ORIGIN=https://cegx.quantumonline.co.uk
FRONTEND_URL=http://localhost:3002
APP_URL=http://localhost:3003
# Relative /api works for both local dev and production because Next.js
# proxies /api requests to the backend via rewrite rules in next.config.ts.
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=http://localhost:3002

# Grok AI (xAI) - Get your API key from https://console.x.ai
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-3
