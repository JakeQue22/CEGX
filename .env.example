# Root environment file for Docker Compose
# Copy this to .env and fill in your values

# PostgreSQL (port 5433 to avoid conflict with existing postgres on 5432)
POSTGRES_USER=cegx
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=cegx

# JWT Secrets (minimum 32 characters each)
JWT_SECRET=your-jwt-secret-minimum-32-characters-here
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URLs
FRONTEND_URL=http://localhost:3002
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Grok AI (xAI) - Get your API key from https://console.x.ai
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-3
